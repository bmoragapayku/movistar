# Puerto donde escucha el backend (default 8787)
PORT=8787

# URL de validación de tokens de Google (no cambiar)
GOOGLE_AUTH_URL=https://www.googleapis.com/oauth2/v3/userinfo

# Secreto para firmar JWT propios de Movistar — usa un valor largo y aleatorio
# Ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOVISTAR_SESSION_SECRET=change-me

# Proyecto Supabase Movistar
SUPABASE_URL=https://wlkwvzwxshbkwyeyhncd.supabase.co

# Service role key de Supabase — SOLO en backend, nunca en HTML
# Supabase > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=change-me

# Origen(es) permitidos por CORS — separar con comas para varios
# Desarrollo local:   http://localhost:8080
# Producción:         https://mi-dominio.com
CORS_ORIGIN=http://localhost:8080

# Resend — proveedor de email (resend.com, gratis hasta 3000/mes)
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=change-me

# Dirección de envío. En Resend gratis usa onboarding@resend.dev (solo para pruebas).
# Para producción configura tu dominio verificado en Resend.
MAIL_FROM=Movistar Arena <onboarding@resend.dev>
